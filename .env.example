# Copy to .env, then set the credential with:  node scripts/set-password.js <user> <pass>
# (that command fills ARTHA_USER / ARTHA_PASS_HASH / ARTHA_SECRET for you)

ARTHA_USER=
ARTHA_PASS_HASH=          # scrypt hash — never store a plaintext password here
ARTHA_SECRET=             # random hex; signs the session cookie
# PORT=5173
# ARTHA_SESSION_HOURS=168  # session lifetime (default 7 days)
