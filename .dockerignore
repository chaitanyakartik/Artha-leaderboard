*.sqlite-*
*.db

# Secrets — injected at runtime via env_file / -e, never copied in
.env

# VCS / local cruft
.git
.gitignore
.DS_Store
npm-debug.log*

# Docker + heavy docs not needed at runtime
Dockerfile
docker-compose.yml
.dockerignore
docs/design-explorations
scratchpad
